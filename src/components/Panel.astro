---
/* The list, and the two switches over it.
 *
 * Two lists, one panel: the songs are a playlist of this station's own, the
 * podcast is a show that happens to be listenable here. The page arrives with
 * the rows already in it — a permalink with its one row, a list with all of
 * them — and the deck rebuilds them a moment later out of the manifest and
 * the feed.
 *
 * #albs is the album selector, over the songs and not over the episodes:
 * `all` and every album the index declares, each a link to its own address at
 * the site root, with the album in view marked as the page being read. The
 * deck rebuilds it from the index a moment later, the same trade the rows
 * make.
 *
 * #rowCaret, under the list, is the caret on an episode's row. The deck
 * builds those rows itself, so what it copies into one is markup this build
 * rendered: both faces, and the row's class decides which shows, the same
 * trade the two-state buttons make. An element of its own, not a face off the
 * theme menu's caret, because a row points sideways and that one points up.
 */
import { BASE, SHOW_PODCAST } from '../lib/site.ts';
import { noteFor, panelTitle, rowsFor } from '../lib/rows.ts';
import type { Album } from '../lib/lists.ts';
import type { Item, Show } from '../lib/item.ts';
import type { Kind } from '../lib/slug.ts';
import TrackRow from './TrackRow.astro';
import Icon from './Icon.astro';

interface Props {
  kind: Kind;
  /** The whole list. A permalink page passes it too, so its one row keeps the
      number it has in its album and the note can count the rest. */
  list: Item[];
  /** The one this page is for, if it is for one. */
  only?: Item | null;
  /** Every album, in the order the index declares them. */
  albums: Album[];
  /** The album this page answers for, if it answers for one: the address. */
  album?: string;
  show: Show;
}

const { kind, list, only = null, albums, album = '', show } = Astro.props;
const podcast = kind === 'podcast';
const rows = rowsFor(list, kind, only);
// The album in the address, if the index still carries it: one whose page was
// built and whose album has since gone is not named as being read.
const named = albums.find((a) => a.slug === album) ?? null;
const title = panelTitle(kind, show, named ? named.name : '');
const note = noteFor(kind, list, only, show);
---
<section class="playlist" aria-label={podcast ? 'Episodes' : 'Playlist'}>
  <div class="panel-head">
    <h2 class="panel-title"><span id="playlistKind">{title.kind}</span> &#8212; <span id="playlistName">{title.name}</span></h2>
    <div class="head-btns">
      <div class="seg" id="seg" hidden={!SHOW_PODCAST}>
        <a class:list={['seg-b', { 'is-on': !podcast }]} id="tabSongs" href={`${BASE}/playlist`} aria-current={!podcast ? 'page' : undefined}><Icon name="note" />songs</a>
        <a class:list={['seg-b', { 'is-on': podcast }]} id="tabPodcast" href={`${BASE}/podcast`} aria-current={podcast ? 'page' : undefined}><Icon name="mic" />podcast</a>
      </div>
      <button type="button" class="back lyr" id="lyricsBtn" aria-expanded="false" aria-controls="lyricsBox" hidden>lyrics</button>
    </div>
  </div>
  <nav class:list={['seg', 'albs']} id="albs" aria-label="Albums" hidden={podcast || !albums.length}>
    <a class:list={['seg-b', { 'is-on': !album }]} data-album="" href={`${BASE}/playlist`} aria-current={!album ? 'page' : undefined}>all</a>
    {albums.map((a) => (
      <a class:list={['seg-b', { 'is-on': a.slug === album }]} data-album={a.slug} href={`${BASE}/${a.slug}`} aria-current={a.slug === album ? 'page' : undefined}>{a.name.toLowerCase()}</a>
    ))}
  </nav>
  <div class="find" id="findRow">
    <label class="find-l" for="find">find</label>
    <input class="find-i" id="find" type="search" autocomplete="off" spellcheck="false"
           aria-controls="tracks"
           placeholder={podcast ? 'an episode' : 'a song, or whoever made it'} />
    <button type="button" class="find-k" id="findHint" aria-label="Clear the search">/</button>
  </div>
  <div class="tr-head" id="trHead">
    <span>#</span>
    <span>title</span>
    <span class="ta-r">state</span>
  </div>
  <ul class="tracks" id="tracks">
    {rows.map((row) => (
      <TrackRow item={row.item} number={row.number} sub={row.sub} on={row.on} />
    ))}
  </ul>
  <template id="rowCaret"><Icon name="caret-down" /><Icon name="caret-right" /></template>
  <div class="lyr-box" id="lyricsBox" hidden>
    <ol class="lyrics" id="lyrics"></ol>
  </div>
  <p class="panel-note" id="playlistNote" set:html={note}></p>
</section>
