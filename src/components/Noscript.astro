---
import { SHOW_FEED } from '../lib/site.ts';
import type { Album } from '../lib/lists.ts';

interface Props {
  /** Every album, in the order the index declares them: each album's songs
      live in a directory of its own, and a listener without JavaScript is
      told which. */
  albums: Album[];
}

const { albums } = Astro.props;
---
<noscript>
  <div class="noscript">
    <h2>Omarchy Radio needs JavaScript to play</h2>
    <p>The deck plays the playlist in the browser. Every song is a file in the repo, so the list below links straight to them, and any media player will do:</p>
    <ul>
      {albums.map((a) => (
        <li><code>public/tracks/{a.slug}/</code> &#8212; the {a.name} album's songs, one file each</li>
      ))}
      <li><code>{SHOW_FEED}</code> &#8212; Omarchy Stories, in any podcast app</li>
    </ul>
    <p>More about the desktop at <a href="https://omarchy.org">omarchy.org</a>.</p>
  </div>
</noscript>
