---
/* One page per song.
 *
 * A link that is shared has to arrive as a document of its own: the song's
 * name in the tab, its own card wherever it is pasted, and the song itself
 * baked into the page so it starts playing before anything is fetched — while
 * the press that opened the link still counts as engagement.
 */
import type { GetStaticPaths } from 'astro';
import Deck from '../../layouts/Deck.astro';
import { readEpisodes, readTracks, readAlbums } from '../../lib/sources.ts';
import { isReservedSlug, seedOf } from '../../lib/lists.ts';
import type { Item, Show } from '../../lib/item.ts';
import { audioMeta } from '../../lib/seo.ts';
import { songNode } from '../../lib/schema.ts';
import { CANON } from '../../lib/site.ts';

export const getStaticPaths = (() => {
  const tracks = readTracks();
  const show = readEpisodes();
  const albums = readAlbums();

  for (const track of tracks) {
    if (isReservedSlug(track.key)) {
      throw new Error(
        `${JSON.stringify(track.title)} slugs to ${track.key}, which is the address of the ` +
        'list itself. Give it a title that does not, or the page for one of them would ' +
        'quietly overwrite the other.',
      );
    }
  }

  return tracks.map((track) => ({
    params: { slug: track.slug },
    props: {
      track, tracks, show,
      /* The album the song is in, by name: the page says where the song comes
         from, and every song is in exactly one — readTracks() stamps a song
         with the directory its list was read out of, and refuses a directory
         the index does not declare. */
      albumName: albums.find((a) => a.slug === track.album)!.name,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  track: Item;
  tracks: Item[];
  show: Show;
  albumName: string;
}

const { track, tracks, show, albumName } = Astro.props;
const path = `/${track.key}`;
/* A song with no artist is named by its title alone: a byline for a name the
   file does not carry reads as a page about somebody who is not there. */
const byline = track.artist ? ` by ${track.artist}` : '';
const audio = `${CANON}/${track.url.replace(/^\/+/, '')}`;
---
<Deck
  head={{
    title: `${track.title}${byline} · Omarchy Radio`,
    description:
      `${track.title}${byline}, on Omarchy Radio: ` +
      `a song from the ${albumName} album. Press play.`,
    path,
    ogType: 'music.song',
    extra: audioMeta(audio),
  }}
  schema={songNode(track, path)}
  seed={seedOf(track)}
  kind="playlist"
  list={tracks}
  only={track}
  show={show}
/>
